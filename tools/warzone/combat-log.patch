+namespace {
+	void WriteJsonString(ostream &out, const string &text)
+	{
+		out << '"';
+		for(char c : text)
+		{
+			if(c == '"' || c == '\\')
+				out << '\\' << c;
+			else if(static_cast<unsigned char>(c) < 0x20)
+				out << ' ';
+			else
+				out << c;
+		}
+		out << '"';
+	}
+}
+
+
+
+void Ship::WriteCombatSample(ostream &out, int step) const
+{
+	out << "{\"step\":" << step << ",\"id\":";
+	WriteJsonString(out, uuid.ToString());
+	out << ",\"model\":";
+	WriteJsonString(out, TrueModelName());
+	out << ",\"gov\":";
+	WriteJsonString(out, government ? government->TrueName() : string());
+	out << ",\"energy\":" << energy << ",\"energy_max\":" << attributes.Get("energy capacity")
+		<< ",\"heat\":" << heat << ",\"heat_max\":" << MaximumHeat()
+		<< ",\"shields\":" << shields << ",\"shields_max\":" << MaxShields()
+		<< ",\"hull\":" << hull << ",\"hull_max\":" << MaxHull() << ",\"hull_min\":" << MinimumHull()
+		<< ",\"fuel\":" << fuel << ",\"fuel_max\":" << attributes.Get("fuel capacity")
+		<< ",\"speed\":" << velocity.Length()
+		<< ",\"disabled\":" << (isDisabled ? 1 : 0)
+		<< ",\"destroyed\":" << (IsDestroyed() ? 1 : 0)
+		<< ",\"overheated\":" << (isOverheated ? 1 : 0)
+		<< ",\"jumping\":" << (hyperspaceCount || commands.Has(Command::JUMP) ? 1 : 0)
+		<< ",\"fleeing\":" << (IsFleeing() ? 1 : 0);
+	shared_ptr<Ship> target = GetTargetShip();
+	out << ",\"target\":";
+	if(target && target->GetGovernment() && government && target->GetGovernment()->IsEnemy(government))
+		out << position.Distance(target->Position());
+	else
+		out << -1;
+	out << ",\"ammo\":{";
+	bool first = true;
+	map<const Outfit *, bool> seen;
+	for(const Hardpoint &hardpoint : armament.Get())
+	{
+		const Weapon *weapon = hardpoint.GetWeapon();
+		if(!weapon || !weapon->Ammo() || seen[weapon->Ammo()])
+			continue;
+		seen[weapon->Ammo()] = true;
+		if(!first)
+			out << ',';
+		first = false;
+		WriteJsonString(out, weapon->Ammo()->TrueName());
+		out << ':' << OutfitCount(weapon->Ammo());
+	}
+	out << '}';
+	// The first line for each ship also lists its category and outfits.
+	if(!combatOutfitsLogged)
+	{
+		combatOutfitsLogged = true;
+		out << ",\"category\":";
+		WriteJsonString(out, baseAttributes.Category());
+		out << ",\"outfits\":{";
+		first = true;
+		for(const auto &it : outfits)
+		{
+			if(!first)
+				out << ',';
+			first = false;
+			WriteJsonString(out, it.first->TrueName());
+			out << ':' << it.second;
+		}
+		out << '}';
+	}
+	out << ",\"shots\":{";
+	first = true;
+	for(const auto &it : combatShots)
+	{
+		if(!first)
+			out << ',';
+		first = false;
+		WriteJsonString(out, it.first);
+		out << ':' << it.second;
+	}
+	out << "}}\n";
+	combatShots.clear();
+}
