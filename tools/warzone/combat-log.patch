 	// Now, all the ships must decide what they are doing next.
 	ai.Step(activeCommands);
 
+	// Observation build: every half second, log every ship in the player's system.
+	static ofstream *combatLog = nullptr;
+	static bool combatLogChecked = false;
+	if(!combatLogChecked)
+	{
+		combatLogChecked = true;
+		const char *path = getenv("ES_COMBAT_LOG");
+		if(path && *path)
+			combatLog = new ofstream(path, ios::app);
+	}
+	if(combatLog && !(step % 30))
+	{
+		for(const shared_ptr<Ship> &it : ships)
+			if(it->GetSystem() == playerSystem && it != player.FlagshipPtr())
+				it->WriteCombatSample(*combatLog, step);
+		combatLog->flush();
+	}
+
 	// Clear the active player's commands, because they are all processed at this point.
 	activeCommands.Clear();
 
